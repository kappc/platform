{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "deployment": {
      "properties": {
        "replicas": {
          "default": 1,
          "title": "replicas",
          "type": "integer"
        }
      },
      "required": [
        "replicas"
      ],
      "title": "deployment",
      "type": "object"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "httpRoute": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "listener": {
          "default": "http",
          "title": "listener",
          "type": "string"
        },
        "path": {
          "default": "/",
          "title": "path",
          "type": "string"
        },
        "port": {
          "default": 80,
          "title": "port",
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "listener",
        "path",
        "port"
      ],
      "title": "httpRoute",
      "type": "object"
    },
    "image": {
      "properties": {
        "digest": {
          "default": "sha256:c4717a8d1f0134a7444e24f881160e033991f23027c6c5a9a3f8fd22e70d1d44",
          "title": "digest",
          "type": "string"
        },
        "repository": {
          "default": "traefik/whoami",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "v1.12.0",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "tag",
        "digest"
      ],
      "title": "image",
      "type": "object"
    },
    "networkPolicy": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "port": {
          "default": 80,
          "title": "port",
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "port"
      ],
      "title": "networkPolicy",
      "type": "object"
    },
    "resources": {
      "properties": {
        "limits": {
          "properties": {
            "cpu": {
              "default": "100m",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "64Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ],
          "title": "limits",
          "type": "object"
        },
        "requests": {
          "properties": {
            "cpu": {
              "default": "10m",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "16Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ],
          "title": "requests",
          "type": "object"
        }
      },
      "required": [
        "requests",
        "limits"
      ],
      "title": "resources",
      "type": "object"
    }
  },
  "required": [
    "deployment",
    "image",
    "httpRoute",
    "networkPolicy",
    "resources"
  ],
  "type": "object"
}