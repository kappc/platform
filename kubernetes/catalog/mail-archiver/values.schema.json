{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "database": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "image": {
          "properties": {
            "digest": {
              "default": "sha256:dab846a58e8ca3c8872584ab2225ee93fb9e659a87c52e163fefae9275b46f51",
              "title": "digest",
              "type": "string"
            },
            "repository": {
              "default": "ghcr.io/cloudnative-pg/postgresql",
              "title": "repository",
              "type": "string"
            },
            "tag": {
              "default": "17.7",
              "title": "tag",
              "type": "string"
            }
          },
          "required": [
            "repository",
            "tag",
            "digest"
          ],
          "title": "image",
          "type": "object"
        },
        "resources": {
          "properties": {
            "limits": {
              "properties": {
                "cpu": {
                  "default": "1",
                  "title": "cpu",
                  "type": "string"
                },
                "memory": {
                  "default": "1Gi",
                  "title": "memory",
                  "type": "string"
                }
              },
              "required": [
                "cpu",
                "memory"
              ],
              "title": "limits",
              "type": "object"
            },
            "requests": {
              "properties": {
                "cpu": {
                  "default": "100m",
                  "title": "cpu",
                  "type": "string"
                },
                "memory": {
                  "default": "256Mi",
                  "title": "memory",
                  "type": "string"
                }
              },
              "required": [
                "cpu",
                "memory"
              ],
              "title": "requests",
              "type": "object"
            }
          },
          "required": [
            "requests",
            "limits"
          ],
          "title": "resources",
          "type": "object"
        },
        "storage": {
          "properties": {
            "size": {
              "default": "8Gi",
              "title": "size",
              "type": "string"
            }
          },
          "required": [
            "size"
          ],
          "title": "storage",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "image",
        "storage",
        "resources"
      ],
      "title": "database",
      "type": "object"
    },
    "env": {
      "description": "Application settings as environment variables, for example `Section__Key: value`",
      "properties": {
        "Authentication__CookieSameSite": {
          "default": "Lax",
          "title": "Authentication__CookieSameSite",
          "type": "string"
        }
      },
      "required": [
        "Authentication__CookieSameSite"
      ],
      "title": "env",
      "type": "object"
    },
    "externalSecrets": {
      "items": {
        "anyOf": [
          {
            "properties": {
              "data": {
                "properties": {
                  "adminPassword": {
                    "default": "admin-password",
                    "title": "adminPassword",
                    "type": "string"
                  },
                  "adminUsername": {
                    "default": "admin-username",
                    "title": "adminUsername",
                    "type": "string"
                  },
                  "dbPassword": {
                    "default": "db-password",
                    "title": "dbPassword",
                    "type": "string"
                  },
                  "encryptionKey": {
                    "default": "encryption-key",
                    "title": "encryptionKey",
                    "type": "string"
                  }
                },
                "required": [
                  "dbPassword",
                  "adminUsername",
                  "adminPassword",
                  "encryptionKey"
                ],
                "title": "data",
                "type": "object"
              },
              "name": {
                "default": "mail-archiver-config",
                "title": "name",
                "type": "string"
              },
              "template": {
                "properties": {
                  "Authentication__Password": {
                    "default": "{{ .adminPassword }}",
                    "title": "Authentication__Password",
                    "type": "string"
                  },
                  "Authentication__Username": {
                    "default": "{{ .adminUsername }}",
                    "title": "Authentication__Username",
                    "type": "string"
                  },
                  "ConnectionStrings__DefaultConnection": {
                    "default": "Host=mail-archiver-db-rw;Port=5432;Database=mail-archiver;Username=mail-archiver;Password={{ .dbPassword }};",
                    "title": "ConnectionStrings__DefaultConnection",
                    "type": "string"
                  },
                  "Security__CredentialEncryptionKey": {
                    "default": "{{ .encryptionKey }}",
                    "title": "Security__CredentialEncryptionKey",
                    "type": "string"
                  }
                },
                "required": [
                  "ConnectionStrings__DefaultConnection",
                  "Authentication__Username",
                  "Authentication__Password",
                  "Security__CredentialEncryptionKey"
                ],
                "title": "template",
                "type": "object"
              }
            },
            "required": [
              "name",
              "data",
              "template"
            ],
            "type": "object"
          }
        ],
        "required": []
      },
      "title": "externalSecrets",
      "type": "array"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
