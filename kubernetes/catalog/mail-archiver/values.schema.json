      "title": "networkPolicy",
      "type": "object"
    },
    "persistence": {
      "properties": {
        "dataProtection": {
          "properties": {
            "size": {
              "default": "1Gi",
              "description": "Size of the volume that keeps the keys protecting cookies across restarts",
              "title": "size",
              "type": "string"
            }
          },
          "required": [
            "size"
          ],
          "title": "dataProtection",
          "type": "object"
        }
      },
      "required": [
        "dataProtection"
      ],
      "title": "persistence",
      "type": "object"
    },
    "resources": {
      "properties": {
        "limits": {
          "properties": {
            "cpu": {
              "default": "1",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "1Gi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ],
          "title": "limits",
          "type": "object"
        },
        "requests": {
          "properties": {
            "cpu": {
              "default": "100m",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "256Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [
            "cpu",
            "memory"
          ],
          "title": "requests",
          "type": "object"
        }
      },
      "required": [
        "requests",
        "limits"
      ],
      "title": "resources",
      "type": "object"
    }
