    "networkPolicy": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "port": {
          "default": 5000,
          "title": "port",
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "port"
