        "path": {
          "default": "/",
          "title": "path",
          "type": "string"
        },
        "port": {
          "default": 5000,
          "title": "port",
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "listener",
        "path",
        "port"
      ],
      "title": "httpRoute",
      "type": "object"
    },
    "image": {
      "properties": {
        "digest": {
          "default": "sha256:d354bf8cefc4d825dd22cb2d8a70d6622cabbc08b0fa08983e3660f6c2f0a322",
          "title": "digest",
          "type": "string"
        },
        "repository": {
          "default": "s1t5/mailarchiver",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "2610.1",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "tag",
        "digest"
