{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "envoyProxy": {
      "properties": {
        "name": {
          "default": "envoy-proxy",
          "title": "name",
          "type": "string"
        },
        "service": {
          "properties": {
            "annotations": {
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "externalTrafficPolicy": {
              "default": "Cluster",
              "title": "externalTrafficPolicy",
              "type": "string"
            },
            "port": {
              "default": 80,
              "title": "port",
              "type": "integer"
            },
            "type": {
              "default": "LoadBalancer",
              "title": "type",
              "type": "string"
            }
          },
          "required": [
            "type",
            "port",
            "externalTrafficPolicy",
            "annotations"
          ],
          "title": "service",
          "type": "object"
        }
      },
      "required": [
        "name",
        "service"
      ],
      "title": "envoyProxy",
      "type": "object"
    },
    "gateway": {
      "properties": {
        "allowedRoutes": {
          "description": "Which namespaces may attach routes to all listeners; `Same` admits the gateway namespace only, `All` every\nnamespace, and `Selector` with a `selector` specific namespaces",
          "properties": {
            "namespaces": {
              "properties": {
                "from": {
                  "default": "Same",
                  "title": "from",
                  "type": "string"
                }
              },
              "required": [
                "from"
              ],
              "title": "namespaces",
              "type": "object"
            }
          },
          "required": [
            "namespaces"
          ],
          "title": "allowedRoutes",
          "type": "object"
        },
        "listener": {
          "properties": {
            "name": {
              "default": "http",
              "title": "name",
              "type": "string"
            },
            "port": {
              "default": 80,
              "title": "port",
              "type": "integer"
            }
          },
          "required": [
            "name",
            "port"
          ],
          "title": "listener",
          "type": "object"
        },
        "name": {
          "default": "gateway",
          "title": "name",
          "type": "string"
        },
        "tls": {
          "properties": {
            "certificate": {
              "properties": {
                "dnsNames": {
                  "description": "DNS names of the certificate",
                  "items": {
                    "required": []
                  },
                  "title": "dnsNames",
                  "type": "array"
                },
                "issuerRef": {
                  "description": "Existing cert-manager issuer for the certificate; when empty, a private CA is created",
                  "required": [],
                  "title": "issuerRef",
                  "type": "object"
                }
              },
              "required": [
                "issuerRef",
                "dnsNames"
              ],
              "title": "certificate",
              "type": "object"
            },
            "enabled": {
              "default": false,
              "description": "Add an HTTPS listener that terminates TLS with the certificate in `secretName` (requires cert-manager)",
              "title": "enabled",
              "type": "boolean"
            },
            "listener": {
              "properties": {
                "hostname": {
                  "default": "",
                  "description": "Hostname served by the listener",
                  "title": "hostname",
                  "type": "string"
                },
                "name": {
                  "default": "https",
                  "title": "name",
                  "type": "string"
                },
                "port": {
                  "default": 443,
                  "title": "port",
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "port",
                "hostname"
              ],
              "title": "listener",
              "type": "object"
            },
            "secretName": {
              "default": "gateway-tls",
              "description": "Name of the `Secret` that holds the certificate",
              "title": "secretName",
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "listener",
            "secretName",
            "certificate"
          ],
          "title": "tls",
          "type": "object"
        }
      },
      "required": [
        "name",
        "listener",
        "allowedRoutes",
        "tls"
      ],
      "title": "gateway",
      "type": "object"
    },
    "gateway-helm": {
      "properties": {
        "crds": {
          "properties": {
            "enabled": {
              "default": true,
              "title": "enabled",
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "title": "crds",
          "type": "object"
        },
        "deployment": {
          "properties": {
            "envoyGateway": {
              "properties": {
                "resources": {
                  "properties": {
                    "limits": {
                      "properties": {
                        "cpu": {
                          "default": "500m",
                          "title": "cpu",
                          "type": "string"
                        },
                        "memory": {
                          "default": "512Mi",
                          "title": "memory",
                          "type": "string"
                        }
                      },
                      "required": [
                        "cpu",
                        "memory"
                      ],
                      "title": "limits",
                      "type": "object"
                    },
                    "requests": {
                      "properties": {
                        "cpu": {
                          "default": "100m",
                          "title": "cpu",
                          "type": "string"
                        },
                        "memory": {
                          "default": "256Mi",
                          "title": "memory",
                          "type": "string"
                        }
                      },
                      "required": [
                        "cpu",
                        "memory"
                      ],
                      "title": "requests",
                      "type": "object"
                    }
                  },
                  "required": [
                    "requests",
                    "limits"
                  ],
                  "title": "resources",
                  "type": "object"
                }
              },
              "required": [
                "resources"
              ],
              "title": "envoyGateway",
              "type": "object"
            },
            "replicas": {
              "default": 1,
              "title": "replicas",
              "type": "integer"
            }
          },
          "required": [
            "replicas",
            "envoyGateway"
          ],
          "title": "deployment",
          "type": "object"
        }
      },
      "required": [
        "crds",
        "deployment"
      ],
      "title": "gateway-helm",
      "type": "object"
    },
    "gatewayClass": {
      "properties": {
        "name": {
          "default": "envoy-gateway",
          "title": "name",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "gatewayClass",
      "type": "object"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    }
  },
  "required": [
    "gateway-helm",
    "gatewayClass",
    "gateway",
    "envoyProxy"
  ],
  "type": "object"
}