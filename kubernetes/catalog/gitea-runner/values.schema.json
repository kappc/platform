{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "actions": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        },
        "existingSecret": {
          "default": "gitea-runner",
          "title": "existingSecret",
          "type": "string"
        },
        "existingSecretKey": {
          "default": "token",
          "title": "existingSecretKey",
          "type": "string"
        },
        "giteaRootURL": {
          "default": "http://gitea-http.gitea.svc.cluster.local:3000",
          "description": "URL under which the runner reaches Gitea; the default is the in-cluster service of an instance named `gitea`",
          "title": "giteaRootURL",
          "type": "string"
        },
        "init": {
          "properties": {
            "image": {
              "properties": {
                "digest": {
                  "default": "sha256:a46257e06c82ad85242d0d38077d0a52d9896389ca60a1a59d3463db586e5fa4",
                  "title": "digest",
                  "type": "string"
                },
                "repository": {
                  "default": "busybox",
                  "title": "repository",
                  "type": "string"
                },
                "tag": {
                  "default": "1.38.0",
                  "title": "tag",
                  "type": "string"
                }
              },
              "required": [
                "repository",
                "tag",
                "digest"
              ],
              "title": "image",
              "type": "object"
            }
          },
          "required": [
            "image"
          ],
          "title": "init",
          "type": "object"
        },
        "statefulset": {
          "properties": {
            "annotations": {
              "properties": {
                "reloader.stakater.com/auto": {
                  "default": "true",
                  "title": "reloader.stakater.com/auto",
                  "type": "string"
                }
              },
              "required": [
                "reloader.stakater.com/auto"
              ],
              "title": "annotations",
              "type": "object"
            },
            "dind": {
              "properties": {
                "digest": {
                  "default": "sha256:ae083cc7de51e7a8e5a597f8fb774ca7914c408a95fc0f1477826a913479518a",
                  "title": "digest",
                  "type": "string"
                },
                "extraVolumeMounts": {
                  "items": {
                    "anyOf": [
                      {
                        "properties": {
                          "mountPath": {
                            "default": "/home/rootless/.local/share/docker",
                            "title": "mountPath",
                            "type": "string"
                          },
                          "name": {
                            "default": "docker-data",
                            "title": "name",
                            "type": "string"
                          }
                        },
                        "required": [
                          "name",
                          "mountPath"
                        ],
                        "type": "object"
                      }
                    ],
                    "required": []
                  },
                  "title": "extraVolumeMounts",
                  "type": "array"
                },
                "repository": {
                  "default": "docker",
                  "title": "repository",
                  "type": "string"
                },
                "resources": {
                  "properties": {
                    "limits": {
                      "properties": {
                        "cpu": {
                          "default": "2",
                          "title": "cpu",
                          "type": "string"
                        },
                        "memory": {
                          "default": "4Gi",
                          "title": "memory",
                          "type": "string"
                        }
                      },
                      "required": [
                        "cpu",
                        "memory"
                      ],
                      "title": "limits",
                      "type": "object"
                    },
                    "requests": {
                      "properties": {
                        "cpu": {
                          "default": "250m",
                          "title": "cpu",
                          "type": "string"
                        },
                        "memory": {
                          "default": "512Mi",
                          "title": "memory",
                          "type": "string"
                        }
                      },
                      "required": [
                        "cpu",
                        "memory"
                      ],
                      "title": "requests",
                      "type": "object"
                    }
                  },
                  "required": [
                    "requests",
                    "limits"
                  ],
                  "title": "resources",
                  "type": "object"
                },
                "rootless": {
                  "default": true,
                  "title": "rootless",
                  "type": "boolean"
                },
                "tag": {
                  "default": "29.9.2-dind-rootless",
                  "title": "tag",
                  "type": "string"
                }
              },
              "required": [
                "rootless",
                "repository",
                "tag",
                "digest",
                "resources",
                "extraVolumeMounts"
              ],
              "title": "dind",
              "type": "object"
            },
            "extraVolumes": {
              "items": {
                "anyOf": [
                  {
                    "properties": {
                      "name": {
                        "default": "docker-data",
                        "title": "name",
                        "type": "string"
                      },
                      "persistentVolumeClaim": {
                        "properties": {
                          "claimName": {
                            "default": "gitea-runner-docker",
                            "title": "claimName",
                            "type": "string"
                          }
                        },
                        "required": [
                          "claimName"
                        ],
                        "title": "persistentVolumeClaim",
                        "type": "object"
                      }
                    },
                    "required": [
                      "name",
                      "persistentVolumeClaim"
                    ],
                    "type": "object"
                  }
                ],
                "required": []
              },
              "title": "extraVolumes",
              "type": "array"
            },
            "persistence": {
              "properties": {
                "size": {
                  "default": "1Gi",
                  "title": "size",
                  "type": "string"
                }
              },
              "required": [
                "size"
              ],
              "title": "persistence",
              "type": "object"
            },
            "runner": {
              "properties": {
                "config": {
                  "default": "log:\n  level: info\ncache:\n  enabled: false\ncontainer:\n  require_docker: true\n  docker_timeout: 300s\n",
                  "title": "config",
                  "type": "string"
                },
                "digest": {
                  "default": "sha256:cdc5336a0b0be435b6a21379edf5cccffcc6733cacd5672fcf5769716f56a768",
                  "title": "digest",
                  "type": "string"
                },
                "registry": {
                  "default": "docker.io",
                  "title": "registry",
                  "type": "string"
                },
                "repository": {
                  "default": "gitea/runner",
                  "title": "repository",
                  "type": "string"
                },
                "resources": {
                  "properties": {
                    "limits": {
                      "properties": {
                        "cpu": {
                          "default": "1",
                          "title": "cpu",
                          "type": "string"
                        },
                        "memory": {
                          "default": "1Gi",
                          "title": "memory",
                          "type": "string"
                        }
                      },
                      "required": [
                        "cpu",
                        "memory"
                      ],
                      "title": "limits",
                      "type": "object"
                    },
                    "requests": {
                      "properties": {
                        "cpu": {
                          "default": "100m",
                          "title": "cpu",
                          "type": "string"
                        },
                        "memory": {
                          "default": "256Mi",
                          "title": "memory",
                          "type": "string"
                        }
                      },
                      "required": [
                        "cpu",
                        "memory"
                      ],
                      "title": "requests",
                      "type": "object"
                    }
                  },
                  "required": [
                    "requests",
                    "limits"
                  ],
                  "title": "resources",
                  "type": "object"
                },
                "tag": {
                  "default": "5.3.0",
                  "title": "tag",
                  "type": "string"
                }
              },
              "required": [
                "registry",
                "repository",
                "tag",
                "digest",
                "resources",
                "config"
              ],
              "title": "runner",
              "type": "object"
            },
            "securityContext": {
              "properties": {
                "fsGroup": {
                  "default": 1000,
                  "title": "fsGroup",
                  "type": "integer"
                },
                "runAsGroup": {
                  "default": 1000,
                  "title": "runAsGroup",
                  "type": "integer"
                },
                "runAsNonRoot": {
                  "default": true,
                  "title": "runAsNonRoot",
                  "type": "boolean"
                },
                "runAsUser": {
                  "default": 1000,
                  "title": "runAsUser",
                  "type": "integer"
                },
                "seccompProfile": {
                  "properties": {
                    "type": {
                      "default": "RuntimeDefault",
                      "title": "type",
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "title": "seccompProfile",
                  "type": "object"
                }
              },
              "required": [
                "runAsNonRoot",
                "runAsUser",
                "runAsGroup",
                "fsGroup",
                "seccompProfile"
              ],
              "title": "securityContext",
              "type": "object"
            },
            "serviceAccountName": {
              "default": "gitea-runner",
              "title": "serviceAccountName",
              "type": "string"
            }
          },
          "required": [
            "annotations",
            "serviceAccountName",
            "securityContext",
            "persistence",
            "extraVolumes",
            "runner",
            "dind"
          ],
          "title": "statefulset",
          "type": "object"
        }
      },
      "required": [
        "enabled",
        "giteaRootURL",
        "existingSecret",
        "existingSecretKey",
        "init",
        "statefulset"
      ],
      "title": "actions",
      "type": "object"
    },
    "externalSecrets": {
      "items": {
        "anyOf": [
          {
            "properties": {
              "data": {
                "properties": {
                  "token": {
                    "default": "registration-token",
                    "title": "token",
                    "type": "string"
                  }
                },
                "required": [
                  "token"
                ],
                "title": "data",
                "type": "object"
              },
              "name": {
                "default": "gitea-runner",
                "title": "name",
                "type": "string"
              }
            },
            "required": [
              "name",
              "data"
            ],
            "type": "object"
          }
        ],
        "required": []
      },
      "title": "externalSecrets",
      "type": "array"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "networkPolicy": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ],
      "title": "networkPolicy",
      "type": "object"
    },
    "persistence": {
      "properties": {
        "dockerSize": {
          "default": "20Gi",
          "description": "Size of the volume that caches the images pulled by jobs",
          "title": "dockerSize",
          "type": "string"
        }
      },
      "required": [
        "dockerSize"
      ],
      "title": "persistence",
      "type": "object"
    }
  },
  "required": [
    "networkPolicy",
    "externalSecrets",
    "persistence",
    "actions"
  ],
  "type": "object"
}